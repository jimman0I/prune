### Prune Deep Clean rule text. Generated from Prune 3.x by native/tools/convert-catalog.mjs,
### then kept by hand: 3.x's catalog is frozen and this file is the source now.

cleaner-rules-brave_cache-name = Pamięć podręczna
cleaner-rules-brave_cache-description = Strony, skrypty i obrazy zapisane w pamięci podręcznej. Odbudowywana podczas przeglądania.
cleaner-rules-brave_favicons-name = Ikony witryn
cleaner-rules-brave_favicons-description = Małe ikony wyświetlane obok zakładek i kart. Pobierane ponownie przy następnej wizycie.
cleaner-rules-brave_history-name = Historia przeglądania
cleaner-rules-brave_history-description = Lista odwiedzonych stron oraz skróty do najczęściej odwiedzanych witryn na stronie nowej karty. Witryny z zakładek zachowują swój wpis, więc następnym razem nie są traktowane jak zupełnie nowe.
