cleaner-rules-malwarebytes_logs-name = Servicelogs
cleaner-rules-malwarebytes_logs-description = Scannings- og servicelogs. Scanningshistorikken i selve appen påvirkes ikke.
cleaner-rules-office_web_cache-name = Web- og dokumentcache
cleaner-rules-office_web_cache-description = Cachede kopier af onlinedokumenter og webindhold. Hentes igen, når de åbnes igen.
cleaner-rules-office_mru-name = Senest brugte dokumenter
