cleaner-rules-discord_cache-name = Discord-Cache
cleaner-rules-discord_cache-description = Zwischengespeicherte Bilder, Anhänge und kompilierte Skripte von Discord.
cleaner-rules-discord_logs-name = Protokolle und Absturzberichte
