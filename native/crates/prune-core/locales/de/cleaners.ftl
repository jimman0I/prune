### Prune Deep Clean rule text. Generated from Prune 3.x by native/tools/convert-catalog.mjs,
### then kept by hand: 3.x's catalog is frozen and this file is the source now.

cleaner-rules-brave_cache-name = Cache
cleaner-rules-brave_cache-description = Zwischengespeicherte Seiten, Skripte und Bilder. Wird beim Surfen neu aufgebaut.
cleaner-rules-brave_favicons-name = Website-Symbole
cleaner-rules-brave_favicons-description = Die kleinen Symbole neben Lesezeichen und Tabs. Werden beim nächsten Besuch neu geladen.
cleaner-rules-brave_history-name = Browserverlauf
cleaner-rules-brave_history-description = Die Liste der besuchten Seiten sowie die Verknüpfungen zu den meistbesuchten Seiten auf der Neuer-Tab-Seite. Seiten mit Lesezeichen behalten ihren Eintrag, damit sie beim nächsten Mal nicht als völlig neu gelten.
