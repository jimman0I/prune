cleaner-rules-steam_shader_cache-name = Shadercache
cleaner-rules-steam_shader_cache-description = Gecompileerde shaders voor geïnstalleerde games. Worden opnieuw opgebouwd de volgende keer dat elke game start.
cleaner-rules-steam_depot_cache-name = Download-restanten
