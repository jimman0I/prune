cleaner-rules-vscode_cache-name = VS Code-cache
cleaner-rules-vscode_cache-description = GPU-, code- en CachedData-caches. Worden bij de volgende start automatisch opnieuw opgebouwd.
cleaner-rules-vscode_backup-name = Lokale bestandsgeschiedenis
cleaner-rules-vscode_backup-description = De eigen registratie van VS Code van eerdere versies van bestanden die je hebt bewerkt, weergegeven in de weergave Tijdlijn. Je kunt daarna geen oudere versie meer herstellen via VS Code -- de bestanden zelf blijven ongemoeid.
cleaner-rules-telegram_cache-name = Telegram-cache
cleaner-rules-telegram_cache-description = Gecachte foto's, video's en documenten van Telegram Desktop.
cleaner-rules-slack_cache-name = Slack-cache
