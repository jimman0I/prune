cleaner-rules-teams_cache-name = Microsoft Teams-cache
cleaner-rules-teams_cache-description = Gecachte afbeeldingen, gecompileerde scripts en logs van Teams.
cleaner-rules-zoom_cache-name = Zoom-gegevens en logs
cleaner-rules-zoom_cache-description = De gecachte gegevens en diagnostische logs van Zoom. Je vergaderingsgeschiedenis blijft ongemoeid.
cleaner-rules-epic_games_cache-name = Epic Games Launcher-cache
cleaner-rules-epic_games_cache-description = De webcache en winkelbestanden van de launcher.
cleaner-rules-epic_crash_reports-name = Crashrapporten
cleaner-rules-epic_crash_reports-description = Rapporten die zijn weggeschreven toen de launcher crashte.
cleaner-rules-riot_client_logs-name = Riot Client-logs
cleaner-rules-riot_client_logs-description = Diagnostische logs van de Riot Client en de bijbehorende games.
cleaner-rules-overwolf_cache-name = Overwolf-cache en -logs
cleaner-rules-overwolf_cache-description = De browsercache en applogs van Overwolf.
cleaner-rules-nvidia_shader_cache-name = NVIDIA-shadercache
cleaner-rules-nvidia_shader_cache-description = Gecompileerde GPU-shaders. Worden automatisch opnieuw opgebouwd; daarna start elke game de eerste keer iets langzamer.
cleaner-rules-directx_shader_cache-name = DirectX-shadercache
cleaner-rules-directx_shader_cache-description = De eigen gecompileerde shadercache van Windows. Wordt automatisch opnieuw opgebouwd.
cleaner-rules-adobe_media_cache-name = Adobe Media Cache
cleaner-rules-adobe_media_cache-description = Peakbestanden en geconformeerde audio die Adobe-apps tijdens het bewerken genereren. Worden op aanvraag opnieuw gemaakt en zijn vaak erg groot.
cleaner-rules-jetbrains_caches-name = Caches van JetBrains-IDE's
cleaner-rules-jetbrains_caches-description = Index- en lokale-geschiedeniscaches van elke geïnstalleerde JetBrains-IDE.
cleaner-rules-npm_cache-name = npm-cache
cleaner-rules-npm_cache-description = De cache met pakketarchieven (tarballs) van npm (_cacache). Wordt op aanvraag opnieuw gedownload; op een ontwikkelmachine vaak enkele gigabytes.
cleaner-rules-yarn_cache-name = Yarn-cache
cleaner-rules-yarn_cache-description = De globale pakketcache van Yarn. Wordt op aanvraag opnieuw gedownload.
cleaner-rules-pip_cache-name = pip-cache
cleaner-rules-pip_cache-description = Python-wheel- en HTTP-cache. Wordt op aanvraag opnieuw gedownload.
cleaner-rules-nuget_cache-name = NuGet-cache
cleaner-rules-nuget_cache-description = {"."}NET-pakketcache. Wordt op aanvraag hersteld.
cleaner-rules-gradle_cache-name = Gradle-cache
cleaner-rules-gradle_cache-description = De cache met gedownloade dependencies van Gradle. Wordt bij de volgende build opnieuw gedownload.
cleaner-rules-electron_builder_cache-name = electron-builder-cache
cleaner-rules-electron_builder_cache-description = Gedownloade Electron-binaries en verpakkingstools. Worden bij de volgende build opnieuw opgehaald.
cleaner-rules-vim_history-name = Vim-geschiedenis
cleaner-rules-vim_history-description = De bestands-, opdracht- en zoekgeschiedenis van Vim, plus open buffers -- ~/.viminfo.
cleaner-rules-firefox_cookies-name = Cookies
cleaner-rules-firefox_cookies-description = Logt je uit bij elke site die je had onthouden.
cleaner-rules-firefox_form_history-name = Formuliergeschiedenis
cleaner-rules-firefox_form_history-description = Tekst die u in webformulieren en zoekvelden hebt getypt en die opnieuw als suggestie wordt aangeboden. Opgeslagen aanmeldingen blijven ongemoeid.
cleaner-rules-firefox_sessions-name = Geopende tabbladen en sessie
cleaner-rules-firefox_sessions-description = Verliest de tabbladen die nu openstaan en de tabbladen die „Vorige sessie herstellen” zou terugbrengen.
cleaner-rules-firefox_crash_reports-name = Crashrapporten
cleaner-rules-firefox_crash_reports-description = Crashdumps en -rapporten die Firefox na een crash bewaart. Alleen nuttig als u er een naar Mozilla verstuurt.
cleaner-rules-librewolf_cache-name = Cache
