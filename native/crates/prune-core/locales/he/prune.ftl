settings-updateStatus-newerAvailable = Prune { $version } זמין.
settings-updateStatus-openDownloadPage = פתח את דף ההורדה
settings-updateStatus-upToDate = יש לך את הגרסה העדכנית ביותר ({ $version }).
settings-updateStatus-openPageError = לא ניתן היה לפתוח את הדף: { $error }
settings-showFreeSpace-title = הצג שטח פנוי במפת הדיסק
settings-showFreeSpace-description = מצייר את השטח הפנוי בכונן כבלוק נוסף כשסורקים כונן שלם, כך שכל תיקייה נקראת כחלק מהכונן ולא מהשטח בשימוש.
settings-deepCleanRemoval-title = כשניקוי מעמיק מסיר קבצים
settings-deepCleanRemoval-quarantine-label = העברה להסגר (אפשר להחזיר)
settings-deepCleanRemoval-quarantine-description = שום דבר לא נמחק. הקבצים עוברים להסגר של Prune, והכונן מקבל את המקום בחזרה כשתרוקן אותו.
settings-deepCleanRemoval-delete-label = מחיקה מיידית (משחררת מקום, אי אפשר לבטל)
settings-deepCleanRemoval-delete-description = הקבצים מוסרים ברגע שתאשר, ולכן המקום מתפנה מיד. כללים שמאבדים נתונים עדיין שואלים קודם.
settings-deepCleanRemoval-deleteWarning = עם מחיקה מיידית אי אפשר לבטל את הניקוי. ניקויים מתוזמנים עדיין מעבירים קבצים להסגר.
settings-deepCleanRemoval-autoQuarantineNote = לא בשימוש כל עוד ניקוי מעמיק מוחק קבצים מיד.
settings-autoQuarantine-title = הסגר אוטומטי
settings-autoQuarantine-description = ניקוי מעמיק מעביר את מה שהוא מסיר להסגר של Prune, שממנו תוכל לשחזר אותו. כבה זאת והוא ילך במקום זאת לסל המיחזור של Windows — עדיין ניתן לשחזור, רק במקום שאתה כבר יודע איך לרוקן.
settings-skipRecent-title = השאר קבצים אחרונים לנפשם
settings-skipRecent-description = מדלג על כל דבר שהשתנה בשעות האחרונות. בתיקיית זמני, קובץ שנכתב כרגע נראה בדיוק כמו קובץ שננטש לפני שנתיים — וזה מה שמונע מתוכנית התקנה שלא הסתיימה להימחק בטעות. 0 מכבה זאת.
settings-skipRecent-hoursUnit = שעות
settings-skipRecent-ariaLabel = שעות להשאיר קבצים אחרונים לנפשם
settings-restorePointCleanup-title = נקודת שחזור לפני הסרת שאריות
settings-restorePointCleanup-description = נוצרת לפני ש-Prune מסיר את קובצי השאריות ומפתחות הרישום שבחרת, כולל אחרי הסרה כפויה. מופעלת כברירת מחדל; אינה עושה דבר אם הגנת המערכת כבויה.
settings-hideUnavailable-title = הסתר כלי ניקוי שלא רלוונטיים
settings-hideUnavailable-description = רוב הרשימה מיועדת לתוכנה שלא קיימת במחשב הזה. הסתרתם משאירה רק את מה שבאמת כאן.
settings-quarantineRetention-title = כמה זמן לשמור פריטים בהסגר
settings-quarantineRetention-description = כל מה ש-Prune מסיר הולך תחילה להסגר, ונשאר שם עד שתרוקן אותו. קבע מספר ימים כדי להשליך גיבויים ישנים יותר מכך. השאר ריק כדי לשמור אותם לנצח.
settings-quarantineRetention-neverPlaceholder = לעולם לא
settings-quarantineRetention-daysUnit = ימים
settings-quarantineRetention-ariaLabel = ימים לשמירת גיבויי הסגר
settings-quarantineMaxSize-title = מגבלת גודל ההסגר
settings-quarantineMaxSize-description = תקרה לכל תיקיית ההסגר. מעליה, הגיבויים הישנים ביותר הולכים ראשונים — האחרון ביותר לעולם לא יושלך, כך שמשהו גדול שהסרת זה עתה נשאר ניתן לשחזור גם אם הוא גדול מהתקרה בעצמו. השאר ריק ללא הגבלה.
settings-quarantineMaxSize-noLimitPlaceholder = ללא הגבלה
settings-quarantineMaxSize-gbUnit = GB
settings-quarantineMaxSize-ariaLabel = גודל מרבי של הסגר בגיגה-בייט
settings-exclusions-title = החרגות
settings-exclusions-description = תיקיות וסוגי קבצים ש-Prune ישאיר לנפשם — ידולגו על ידי הניקוי המעמיק ויוחרגו ממפת הדיסק — בנוסף לאלה שהוא כבר מגן עליהם: מידע על כרך המערכת, הסגרי אנטי-וירוס, מאגר הרכיבים ותריסר נוספים. תיקיות ומפתחות רישום שמופיעים כאן גם לעולם לא יוצעו כשאריות לאחר הסרת התקנה.
settings-exclusions-ariaLabel = נתיב תיקייה, סוג קובץ או מפתח רישום להחרגה
settings-exclusions-add = הוסף
settings-exclusions-invalidFormat = כתוב נתיב תיקייה מלא (D:\Games), סוג קובץ (*.iso) או מפתח רישום (HKCU\Software\Vendor).
settings-exclusions-formatHint = נתיב תיקייה מלא, סוג קובץ שנכתב כמו *.iso, או מפתח רישום כמו HKCU\Software\Vendor
