### Prune Deep Clean rule text. Generated from Prune 3.x by native/tools/convert-catalog.mjs,
### then kept by hand: 3.x's catalog is frozen and this file is the source now.

cleaner-rules-brave_cache-name = Cache
cleaner-rules-brave_cache-description = Halaman, skrip dan imej yang dicache. Dibina semula semasa anda melayari.
cleaner-rules-brave_favicons-name = Ikon laman
cleaner-rules-brave_favicons-description = Ikon kecil yang dipaparkan di sebelah penanda halaman dan tab. Dimuat turun semula pada lawatan seterusnya.
cleaner-rules-brave_history-name = Sejarah penyemakan imbas
cleaner-rules-brave_history-description = Senarai halaman yang dilawati, serta pintasan paling kerap dilawati pada halaman tab baharu. Laman yang ditanda halaman mengekalkan entrinya supaya tidak dianggap baharu sepenuhnya pada kali berikutnya.
cleaner-rules-brave_cookies-name = Kuki
cleaner-rules-brave_cookies-description = Melog keluar anda daripada setiap laman yang mengingati anda.
cleaner-rules-brave_sessions-name = Tab terbuka dan sesi
cleaner-rules-brave_sessions-description = Kehilangan tab yang sedang dibuka dan tab yang akan dikembalikan oleh “pulihkan sesi terakhir”.
cleaner-rules-brave_form_history-name = Isi automatik dan sejarah borang
cleaner-rules-brave_form_history-description = Alamat yang disimpan, entri kad dan apa sahaja yang ditawarkan penyemak imbas untuk dilengkapkan bagi pihak anda.
cleaner-rules-brave_autofill_suggestions-name = Cadangan isi borang
cleaner-rules-brave_autofill_suggestions-description = Teks yang pernah anda taip ke dalam borang web sebelum ini, ditawarkan semula sebagai cadangan. Tidak menyentuh alamat, kad atau kata laluan yang disimpan — lihat “Isi automatik dan sejarah borang” untuk itu.
cleaner-rules-brave_keywords-name = Enjin carian yang anda tambah
cleaner-rules-brave_keywords-description = Pintasan carian tersuai yang anda taip atau tambah sendiri. Enjin terbina dalam penyemak imbas itu sendiri tidak disentuh.
cleaner-rules-brave_site_data-name = Data laman
cleaner-rules-brave_site_data-description = Storan bagi setiap laman. Laman melupakan pilihan anda dan sesetengahnya melog keluar anda.
cleaner-rules-brave_sync-name = Data segerak
cleaner-rules-brave_sync-description = Melog keluar anda daripada Brave Sync dan berhenti berkongsi penanda halaman, kata laluan dan tetapan dengan peranti anda yang lain sehingga anda log masuk semula.
