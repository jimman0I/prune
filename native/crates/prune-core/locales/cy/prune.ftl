settings-updateStatus-openDownloadPage = Agor y dudalen lawrlwytho
settings-updateStatus-upToDate = Rydych ar y fersiwn ddiweddaraf ({ $version }).
settings-updateStatus-openPageError = Methu agor y dudalen: { $error }
settings-showFreeSpace-title = Dangos lle rhydd ar y Map Disg
settings-showFreeSpace-description = Yn tynnu lle rhydd y ddisg fel bloc arall pan fyddwch yn sganio disg gyfan, fel bod pob ffolder yn darllen fel cyfran o'r ddisg yn hytrach na'r lle sy'n cael ei ddefnyddio.
settings-deepCleanRemoval-title = Pan fydd Glanhau Dwfn yn tynnu ffeiliau
settings-deepCleanRemoval-quarantine-label = Symud i'r Cwarantin (gallwch eu rhoi'n ôl)
settings-deepCleanRemoval-quarantine-description = Ni chaiff dim ei ddileu. Mae'r ffeiliau'n mynd i'r Cwarantin yn Prune, ac mae'r gyriant yn cael y lle'n ôl pan fyddwch yn ei wacáu.
settings-deepCleanRemoval-delete-label = Dileu nawr (yn rhyddhau'r lle, ni ellir ei ddadwneud)
settings-deepCleanRemoval-delete-description = Caiff ffeiliau eu tynnu cyn gynted ag y byddwch yn cadarnhau, felly mae'r lle'n rhydd ar unwaith. Mae rheolau sy'n colli data yn dal i ofyn yn gyntaf.
settings-deepCleanRemoval-deleteWarning = Gyda Dileu nawr, ni ellir dadwneud Glanhau. Mae glanhau wedi'i amserlennu yn dal i symud ffeiliau i'r Cwarantin.
settings-deepCleanRemoval-autoQuarantineNote = Ni chaiff ei ddefnyddio tra bydd Glanhau Dwfn yn dileu ffeiliau ar unwaith.
settings-autoQuarantine-title = Cwarantin Awtomatig
settings-autoQuarantine-description = Mae Glanhau Dwfn yn symud yr hyn y mae'n ei gymryd i'r Cwarantin yn Prune, lle gallwch ei roi'n ôl. Diffoddwch hyn a bydd yn mynd i Fin Ailgylchu Windows yn lle hynny — yn dal i fod yn adferadwy, dim ond mewn man rydych eisoes yn gwybod sut i'w wacáu.
settings-skipRecent-title = Gadewch ffeiliau diweddar yn llonydd
settings-skipRecent-description = Hepgor unrhyw beth a addaswyd yn ystod yr oriau diwethaf. Mewn ffolder dros dro, mae ffeil sy'n cael ei hysgrifennu nawr yn edrych yn union fel un a adawyd ddwy flynedd yn ôl — dyma sy'n atal gosodiad hanner gorffenedig rhag cael ei sgubo i fyny. Mae 0 yn ei ddiffodd.
settings-skipRecent-hoursUnit = awr
settings-skipRecent-ariaLabel = Oriau i adael ffeiliau diweddar yn llonydd
settings-restorePointCleanup-title = Pwynt adfer cyn tynnu gweddillion
settings-restorePointCleanup-description = Yn cael ei greu cyn i Prune dynnu'r ffeiliau gweddill a'r allweddi cofrestrfa a ddewisoch, gan gynnwys ar ôl Gorfodi tynnu. Ymlaen yn ddiofyn; ni wna ddim o gwbl os yw Diogelu System wedi'i ddiffodd.
settings-hideUnavailable-title = Cuddio glanhawyr nad ydynt yn berthnasol
settings-hideUnavailable-description = Mae'r rhan fwyaf o'r rhestr ar gyfer meddalwedd nad oes gan y peiriant hwn. Mae cuddio'r rheiny'n gadael dim ond yr hyn sydd yma go iawn.
settings-quarantineRetention-title = Am ba hyd i gadw eitemau yn y Cwarantin
settings-quarantineRetention-description = Mae popeth mae Prune yn ei dynnu'n mynd i'r Cwarantin yn gyntaf, ac yn aros nes i chi ei wacáu. Gosodwch nifer o ddiwrnodau i ollwng copïau wrth gefn hŷn na hynny. Gadewch yn wag i'w cadw am byth.
settings-quarantineRetention-neverPlaceholder = Byth
settings-quarantineRetention-daysUnit = diwrnod
settings-quarantineRetention-ariaLabel = Diwrnodau i gadw copïau wrth gefn Cwarantin
settings-quarantineMaxSize-title = Terfyn maint y Cwarantin
settings-quarantineMaxSize-description = Terfyn ar y ffolder Cwarantin cyfan. Uwch ei ben, mae'r copïau wrth gefn hynaf yn mynd yn gyntaf — ni chaiff yr un mwyaf diweddar ei ollwng byth, felly mae rhywbeth mawr rydych newydd ei dynnu'n aros yn adferadwy hyd yn oed os yw'n fwy na'r terfyn ar ei ben ei hun. Gadewch yn wag am ddim terfyn.
settings-quarantineMaxSize-noLimitPlaceholder = Dim terfyn
settings-quarantineMaxSize-gbUnit = GB
settings-quarantineMaxSize-ariaLabel = Maint mwyaf y Cwarantin mewn gigabeitiau
settings-exclusions-title = Eithriadau
settings-exclusions-description = Ffolderi a mathau o ffeiliau y bydd Prune yn eu gadael yn llonydd — wedi'u hepgor gan Lanhau Dwfn ac wedi'u heithrio o'r Map Disg — ar ben y rhai mae eisoes yn eu diogelu: System Volume Information, cwarantinau gwrthfeirws, y storfa gydrannau a dwsin arall. Ni chaiff y ffolderi na'r allweddi cofrestrfa a restrir yma byth eu cynnig fel gweddillion ar ôl dadosod chwaith.
settings-exclusions-ariaLabel = Llwybr ffolder, math o ffeil neu allwedd cofrestrfa i'w eithrio
settings-exclusions-add = Ychwanegu
settings-exclusions-invalidFormat = Ysgrifennwch lwybr ffolder llawn (D:\Games), math o ffeil (*.iso) neu allwedd cofrestrfa (HKCU\Software\Vendor).
settings-exclusions-formatHint = Llwybr ffolder llawn, math o ffeil wedi'i ysgrifennu fel *.iso, neu allwedd cofrestrfa fel HKCU\Software\Vendor
