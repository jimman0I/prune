### Prune Deep Clean rule text. Generated from Prune 3.x by native/tools/convert-catalog.mjs,
### then kept by hand: 3.x's catalog is frozen and this file is the source now.

cleaner-rules-brave_cache-name = Cache
cleaner-rules-brave_cache-description = Cached pages, scripts and images. Rebuilt as you browse.
cleaner-rules-brave_favicons-name = Site icons
cleaner-rules-brave_favicons-description = The small icons shown beside bookmarks and tabs. Re-downloaded on next visit.
cleaner-rules-brave_history-name = Browsing history
cleaner-rules-brave_history-description = The list of pages visited, plus the most-visited shortcuts on the new tab page. Bookmarked sites keep their entry so they're not treated as brand new next time.
cleaner-rules-brave_cookies-name = Cookies
cleaner-rules-brave_cookies-description = Signs you out of every site that remembered you.
cleaner-rules-brave_sessions-name = Open tabs and session
cleaner-rules-brave_sessions-description = Loses the tabs currently open and the ones "restore last session" would bring back.
cleaner-rules-brave_form_history-name = Autofill and form history
cleaner-rules-brave_form_history-description = Saved addresses, card entries and anything the browser offers to complete for you.
cleaner-rules-brave_autofill_suggestions-name = Form-fill suggestions
cleaner-rules-brave_autofill_suggestions-description = Text you've typed into web forms before, offered back as a suggestion. Does not touch saved addresses, cards or passwords -- see "Autofill and form history" for those.
cleaner-rules-brave_keywords-name = Search engines you've added
cleaner-rules-brave_keywords-description = Custom search shortcuts you've typed or added yourself. Brave's own built-in engines are left alone.
cleaner-rules-brave_site_data-name = Site data
cleaner-rules-brave_site_data-description = Per-site storage. Sites forget your preferences and some sign you out.
cleaner-rules-brave_sync-name = Sync data
cleaner-rules-brave_sync-description = Signs you out of Brave Sync and stops sharing bookmarks, passwords and settings with your other devices until you sign in again.
