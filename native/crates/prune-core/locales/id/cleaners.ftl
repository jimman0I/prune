### Prune Deep Clean rule text. Generated from Prune 3.x by native/tools/convert-catalog.mjs,
### then kept by hand: 3.x's catalog is frozen and this file is the source now.

cleaner-rules-brave_cache-name = Cache
cleaner-rules-brave_cache-description = Halaman, skrip, dan gambar yang di-cache. Dibangun ulang saat menjelajah.
cleaner-rules-brave_favicons-name = Ikon situs
cleaner-rules-brave_favicons-description = Ikon kecil di samping bookmark dan tab. Diunduh ulang saat situs dikunjungi lagi.
cleaner-rules-brave_history-name = Riwayat penjelajahan
cleaner-rules-brave_history-description = Daftar halaman yang pernah dikunjungi, beserta pintasan situs paling sering dikunjungi di halaman tab baru. Situs yang di-bookmark tetap menyimpan entrinya agar tidak dianggap benar-benar baru lain kali.
cleaner-rules-brave_cookies-name = Cookie
cleaner-rules-brave_cookies-description = Keluar dari setiap situs yang sebelumnya mengingat login.
cleaner-rules-brave_sessions-name = Tab terbuka dan sesi
cleaner-rules-brave_sessions-description = Kehilangan tab yang sedang terbuka dan tab yang akan dipulihkan oleh “pulihkan sesi terakhir”.
cleaner-rules-brave_form_history-name = Isi otomatis dan riwayat formulir
cleaner-rules-brave_form_history-description = Alamat tersimpan, entri kartu, dan apa pun yang ditawarkan browser untuk dilengkapi otomatis.
cleaner-rules-brave_autofill_suggestions-name = Saran isi formulir
cleaner-rules-brave_autofill_suggestions-description = Teks yang pernah diketik di formulir web, ditawarkan kembali sebagai saran. Tidak menyentuh alamat, kartu, atau kata sandi tersimpan — lihat “Isi otomatis dan riwayat formulir” untuk itu.
cleaner-rules-brave_keywords-name = Mesin pencari yang ditambahkan
cleaner-rules-brave_keywords-description = Pintasan pencarian kustom yang diketik atau ditambahkan sendiri. Mesin bawaan Brave tidak diubah.
cleaner-rules-brave_site_data-name = Data situs
cleaner-rules-brave_site_data-description = Penyimpanan per situs. Situs melupakan preferensi, dan sebagian akan mengeluarkan akun.
