settings-minimizeToTray-title = تصغير إلى علبة النظام
settings-minimizeToTray-description = إغلاق النافذة يرسل Prune إلى علبة النظام بدلاً من الإنهاء.
settings-lowPowerMode-title = وضع توفير الطاقة
settings-lowPowerMode-description = يوقف الرسم المتحرك في الخلفية مؤقتًا، ويحوّل اللوحات الزجاجية الشفافة إلى لوحات صلبة، ويقصّر الانتقالات لتصبح شبه فورية. يُفعَّل تلقائيًا عند التثبيت إذا بدا أن هذا الجهاز سيستفيد منه؛ يمكنك تغييره هنا في أي وقت.
settings-updateCheck-title = التحقق من وجود تحديثات
settings-updateCheck-description = مرة واحدة يوميًا، يسأل Prune api.github.com عما إذا كان هناك إصدار أحدث. إنه الطلب الوحيد الذي يرسله Prune إلى أي مكان بخلاف هذا الجهاز، ويرى GitHub عنوان IP الخاص بك كما يفعل أي موقع ويب. عندما يكون هناك تحديث، يظهر زر تحديث أسفل الشريط الجانبي، ولا يتم تنزيل أو تثبيت أي شيء حتى تنقر عليه.
settings-autoInstallUpdates-title = تثبيت التحديثات تلقائيًا
settings-autoInstallUpdates-description = يقوم بتنزيل إصدار جديد في الخلفية وتثبيته في المرة التالية التي يُغلق فيها Prune، بدلاً من الانتظار حتى تنقر على زر التحديث. يتطلب التحقق من التحديثات أعلاه.
settings-updateStatus-checking = جارٍ التحقق…
settings-updateStatus-loadError = تعذر التحقق من وجود تحديثات: { $error }
settings-updateStatus-newerAvailable = الإصدار { $version } من Prune متوفر.
settings-updateStatus-openDownloadPage = افتح صفحة التنزيل
settings-updateStatus-upToDate = أنت تستخدم أحدث إصدار ({ $version }).
settings-updateStatus-openPageError = تعذر فتح الصفحة: { $error }
settings-showFreeSpace-title = إظهار المساحة الحرة في خريطة القرص
settings-showFreeSpace-description = يرسم المساحة الحرة للقرص ككتلة إضافية عند فحص قرص كامل، بحيث يُقرأ كل مجلد كحصة من القرص بدلاً من المساحة المستخدمة.
settings-deepCleanRemoval-title = عندما يزيل التنظيف العميق الملفات
settings-deepCleanRemoval-quarantine-label = النقل إلى الحجر الصحي (يمكنك إعادتها)
settings-deepCleanRemoval-quarantine-description = لا يُحذف شيء. تنتقل الملفات إلى الحجر الصحي في Prune، وتعود المساحة إلى القرص عند إفراغه.
settings-deepCleanRemoval-delete-label = الحذف الآن (يحرر المساحة، ولا يمكن التراجع عنه)
settings-deepCleanRemoval-delete-description = تُزال الملفات بمجرد تأكيدك، فتتحرر المساحة فورًا. القواعد التي تفقد بيانات تسأل أولًا كالمعتاد.
settings-deepCleanRemoval-deleteWarning = مع «الحذف الآن» لا يمكن التراجع عن التنظيف. أما عمليات التنظيف المجدولة فما زالت تنقل الملفات إلى الحجر الصحي.
settings-deepCleanRemoval-autoQuarantineNote = لا يُستخدم أثناء حذف التنظيف العميق للملفات فورًا.
settings-autoQuarantine-title = الحجر الصحي التلقائي
settings-autoQuarantine-description = ينقل التنظيف العميق ما يأخذه إلى الحجر الصحي الخاص بـ Prune، حيث يمكنك استعادته. أوقف هذا وسينتقل إلى سلة المحذوفات في Windows بدلاً من ذلك — لا يزال قابلاً للاستعادة، فقط في مكان تعرف بالفعل كيفية إفراغه.
settings-skipRecent-title = ترك الملفات الحديثة وشأنها
settings-skipRecent-description = تخطي أي شيء تم تعديله في الساعات القليلة الماضية. في مجلد مؤقت، يبدو الملف الذي تتم كتابته الآن تمامًا مثل ملف تم التخلي عنه منذ عامين — وهذا ما يمنع مسح تثبيت لم يكتمل. 0 يوقف هذا.
settings-skipRecent-hoursUnit = ساعات
settings-skipRecent-ariaLabel = عدد الساعات لترك الملفات الحديثة وشأنها
settings-restorePointCleanup-title = نقطة استعادة قبل إزالة المخلفات
settings-restorePointCleanup-description = تُنشأ قبل أن يزيل Prune ملفات المخلفات ومفاتيح السجل التي حددتها، بما في ذلك بعد «إزالة قسرية». مفعّلة افتراضيًا، ولا تفعل شيئًا إذا كانت «حماية النظام» متوقفة.
settings-hideUnavailable-title = إخفاء أدوات التنظيف التي لا تنطبق
settings-hideUnavailable-description = معظم القائمة مخصص لبرامج غير موجودة على هذا الجهاز. إخفاء تلك يترك فقط ما هو موجود بالفعل هنا.
settings-quarantineRetention-title = مدة الاحتفاظ بعناصر الحجر الصحي
settings-quarantineRetention-description = كل ما يزيله Prune ينتقل إلى الحجر الصحي أولاً، ويبقى حتى تفرغه. حدد عدد الأيام لحذف النسخ الاحتياطية الأقدم من ذلك. اتركه فارغًا للاحتفاظ بها إلى الأبد.
settings-quarantineRetention-neverPlaceholder = أبدًا
settings-quarantineRetention-daysUnit = أيام
settings-quarantineRetention-ariaLabel = عدد الأيام للاحتفاظ بنسخ الحجر الصحي الاحتياطية
settings-quarantineMaxSize-title = الحد الأقصى لحجم الحجر الصحي
settings-quarantineMaxSize-description = حد أقصى لمجلد الحجر الصحي بأكمله. عند تجاوزه، تُحذف أقدم النسخ الاحتياطية أولاً — أما الأحدث فلا تُحذف أبدًا، لذا فإن أي شيء كبير أزلته للتو يبقى قابلاً للاستعادة حتى لو كان أكبر من الحد بمفرده. اتركه فارغًا لعدم وجود حد.
settings-quarantineMaxSize-noLimitPlaceholder = بلا حد
settings-quarantineMaxSize-gbUnit = جيجابايت
settings-quarantineMaxSize-ariaLabel = الحد الأقصى لحجم الحجر الصحي بالجيجابايت
settings-exclusions-title = الاستثناءات
settings-exclusions-description = المجلدات وأنواع الملفات التي سيتركها Prune وشأنها — يتخطاها التنظيف العميق ويستبعدها من خريطة القرص — بالإضافة إلى ما يحميه بالفعل: معلومات وحدة تخزين النظام، الحجر الصحي لمكافحات الفيروسات، مخزن المكونات وحوالي اثني عشر غيرها. المجلدات ومفاتيح التسجيل المدرجة هنا لا تُعرض أيضًا كبقايا بعد إلغاء التثبيت.
settings-exclusions-ariaLabel = مسار مجلد أو نوع ملف أو مفتاح تسجيل للاستبعاد
settings-exclusions-add = إضافة
settings-exclusions-invalidFormat = اكتب مسار مجلد كاملاً (D:\Games) أو نوع ملف (*.iso) أو مفتاح تسجيل (HKCU\Software\Vendor).
settings-exclusions-formatHint = مسار مجلد كامل، أو نوع ملف مكتوب كـ *.iso، أو مفتاح تسجيل مثل HKCU\Software\Vendor
