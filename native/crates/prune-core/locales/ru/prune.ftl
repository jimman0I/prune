uninstallerV3-history-kind-update = Обновление Windows
uninstallerV3-history-outcome-uninstalled = Удалено
uninstallerV3-history-outcome-removed = Остатки удалены
uninstallerV3-history-outcome-partial = Удалено частично
uninstallerV3-history-destination-quarantine = Карантин
uninstallerV3-history-destination-recycle = Корзина
uninstallerV3-history-destination-permanent = Удалено навсегда
uninstallerV3-history-field-date = Дата
uninstallerV3-history-field-kind = Тип
