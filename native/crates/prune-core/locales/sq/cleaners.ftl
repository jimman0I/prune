cleaner-rules-discord_cache-name = Memoria e fshehtë e Discord
cleaner-rules-discord_cache-description = Imazhe, bashkëngjitje dhe skripte të përpiluara nga Discord, të ruajtura në memorien e fshehtë.
cleaner-rules-discord_logs-name = Regjistrat dhe raportet e rrëzimit
cleaner-rules-discord_logs-description = Regjistra diagnostikimi dhe raporte rrëzimi nga klienti i Discord.
cleaner-rules-discord_cookies-name = Cookie
cleaner-rules-discord_cookies-description = Ju nxjerr nga Discord dhe rivendos preferencat e dritares së tij.
cleaner-rules-discord_history-name = Historia e shfletimit
cleaner-rules-discord_history-description = Të dhënat e sesionit dhe të sigurisë së lidhjes që mban shfletuesi i integruar i Discord.
cleaner-rules-spotify_cache-name = Memoria e fshehtë e Spotify
cleaner-rules-spotify_cache-description = Këngë dhe kopertina të ruajtura lokalisht. Muzika shkarkohet sërish në riprodhimin tjetër.
cleaner-rules-steam_cache-name = Memoria e fshehtë e uebit të Steam
cleaner-rules-steam_cache-description = HTML/JS i ruajtur për shfletuesin e integruar të Steam (dyqani, miqtë, komuniteti).
cleaner-rules-steam_shader_cache-name = Memoria e fshehtë e shaderëve
cleaner-rules-steam_shader_cache-description = Shaderë të përpiluar për lojërat e instaluara. Rindërtohen herën tjetër që ekzekutohet secila lojë.
cleaner-rules-steam_depot_cache-name = Mbetjet e shkarkimeve
cleaner-rules-steam_depot_cache-description = Copa depot që mbetën pasi përfundoi një instalim ose përditësim.
cleaner-rules-steam_logs-name = Regjistrat dhe dump-et e rrëzimeve
cleaner-rules-steam_logs-description = Regjistrat e klientit dhe dump-et e shkruara kur u rrëzua Steam ose një lojë.
cleaner-rules-vscode_cache-name = Memoria e fshehtë e VS Code
cleaner-rules-vscode_cache-description = Memoriet e fshehta të GPU-së, kodit dhe CachedData. Rindërtohen automatikisht në nisjen tjetër.
cleaner-rules-vscode_backup-name = Historia lokale e skedarëve
cleaner-rules-vscode_backup-description = Regjistri i vetë VS Code për versionet e mëparshme të skedarëve që keni redaktuar, i shfaqur në pamjen Timeline. Humbet mundësia për të rikthyer një version më të vjetër përmes VS Code -- skedarët vetë nuk preken.
cleaner-rules-telegram_cache-name = Memoria e fshehtë e Telegram
cleaner-rules-telegram_cache-description = Foto, video dhe dokumente nga Telegram Desktop, të ruajtura në memorien e fshehtë.
cleaner-rules-slack_cache-name = Memoria e fshehtë e Slack
cleaner-rules-slack_cache-description = Avatarë, skedarë dhe skripte të përpiluara nga aplikacioni desktop i Slack, të ruajtura në memorien e fshehtë.
cleaner-rules-teams_cache-name = Memoria e fshehtë e Microsoft Teams
cleaner-rules-teams_cache-description = Imazhe, skripte të përpiluara dhe regjistra nga Teams, të ruajtura në memorien e fshehtë.
cleaner-rules-zoom_cache-name = Të dhënat dhe regjistrat e Zoom
cleaner-rules-zoom_cache-description = Të dhënat e ruajtura dhe regjistrat e diagnostikimit të Zoom. Historia e takimeve nuk preket.
cleaner-rules-epic_games_cache-name = Memoria e fshehtë e Epic Games Launcher
cleaner-rules-epic_games_cache-description = Memoria e fshehtë e uebit e nisësit dhe burimet e dyqanit.
cleaner-rules-epic_crash_reports-name = Raportet e rrëzimit
cleaner-rules-epic_crash_reports-description = Raporte të shkruara kur u rrëzua nisësi.
cleaner-rules-riot_client_logs-name = Regjistrat e Riot Client
cleaner-rules-riot_client_logs-description = Regjistra diagnostikimi nga Riot Client dhe lojërat e tij.
cleaner-rules-overwolf_cache-name = Memoria e fshehtë dhe regjistrat e Overwolf
cleaner-rules-overwolf_cache-description = Memoria e fshehtë e shfletuesit të Overwolf dhe regjistrat e aplikacionit.
cleaner-rules-nvidia_shader_cache-name = Memoria e fshehtë e shaderëve të NVIDIA
cleaner-rules-nvidia_shader_cache-description = Shaderë GPU të përpiluar. Rindërtohen automatikisht — nisja e parë e çdo loje është pak më e ngadaltë më pas.
cleaner-rules-directx_shader_cache-name = Memoria e fshehtë e shaderëve të DirectX
cleaner-rules-directx_shader_cache-description = Memoria e fshehtë e shaderëve të përpiluar e vetë Windows. Rindërtohet automatikisht.
cleaner-rules-adobe_media_cache-name = Memoria e fshehtë e medias së Adobe
cleaner-rules-adobe_media_cache-description = Skedarë peak dhe audio e përshtatur që aplikacionet Adobe i krijojnë gjatë redaktimit. Rigjenerohen sipas nevojës dhe shpesh janë shumë të mëdhenj.
cleaner-rules-jetbrains_caches-name = Memoriet e fshehta të IDE-ve të JetBrains
cleaner-rules-jetbrains_caches-description = Memoriet e fshehta të indeksit dhe të historisë lokale në çdo IDE JetBrains të instaluar.
cleaner-rules-npm_cache-name = Memoria e fshehtë e npm
cleaner-rules-npm_cache-description = Memoria e fshehtë e tarball-eve të paketave të npm (_cacache). Shkarkohet sërish sipas nevojës; shpesh gigabajtë në një kompjuter zhvillimi.
cleaner-rules-yarn_cache-name = Memoria e fshehtë e Yarn
cleaner-rules-yarn_cache-description = Memoria e fshehtë globale e paketave të Yarn. Shkarkohet sërish sipas nevojës.
cleaner-rules-pip_cache-name = Memoria e fshehtë e pip
cleaner-rules-pip_cache-description = Memoria e fshehtë wheel dhe HTTP e Python. Shkarkohet sërish sipas nevojës.
cleaner-rules-nuget_cache-name = Memoria e fshehtë e NuGet
cleaner-rules-nuget_cache-description = Memoria e fshehtë e paketave .NET. Rikthehet sipas nevojës.
cleaner-rules-gradle_cache-name = Memoria e fshehtë e Gradle
cleaner-rules-gradle_cache-description = Memoria e fshehtë e varësive të shkarkuara të Gradle. Shkarkohet sërish në ndërtimin tjetër.
cleaner-rules-electron_builder_cache-name = Memoria e fshehtë e electron-builder
cleaner-rules-electron_builder_cache-description = Binarët e shkarkuar të Electron dhe mjetet e paketimit. Merren sërish në ndërtimin tjetër.
cleaner-rules-vim_history-name = Historia e Vim
cleaner-rules-vim_history-description = Historia e skedarëve, komandave dhe kërkimeve të Vim, plus buferët e hapur -- ~/.viminfo.
cleaner-rules-firefox_cookies-name = Cookie
cleaner-rules-firefox_cookies-description = Ju nxjerr jashtë nga çdo faqe që ju mbante mend.
cleaner-rules-firefox_form_history-name = Historiku i formularëve
cleaner-rules-firefox_form_history-description = Teksti që keni shtypur në formularët e uebit dhe kutitë e kërkimit dhe që ofrohet sërish si sugjerim. Hyrjet e ruajtura nuk preken.
cleaner-rules-firefox_sessions-name = Skedat e hapura dhe sesioni
cleaner-rules-firefox_sessions-description = Humbni skedat e hapura tani dhe ato që “rikthe sesionin e fundit” do t'i sillte përsëri.
cleaner-rules-firefox_crash_reports-name = Raportet e rrëzimeve
cleaner-rules-firefox_crash_reports-description = Zbrazjet dhe raportet e rrëzimeve që Firefox i ruan pas një rrëzimi. Të dobishme vetëm kur dërgoni një te Mozilla.
cleaner-rules-librewolf_cache-name = Memoria e fshehtë
cleaner-rules-librewolf_cache-description = Faqe, skripte dhe imazhe të ruajtura. Rindërtohet ndërsa shfletoni.
cleaner-rules-waterfox_cache-name = Memoria e fshehtë
cleaner-rules-waterfox_cache-description = Faqe, skripte dhe imazhe të ruajtura. Rindërtohet ndërsa shfletoni.
cleaner-rules-zen_cache-name = Memoria e fshehtë
cleaner-rules-zen_cache-description = Faqe, skripte dhe imazhe të ruajtura. Rindërtohet ndërsa shfletoni.
cleaner-rules-palemoon_cache-name = Memoria e fshehtë
cleaner-rules-palemoon_cache-description = Faqe, skripte dhe imazhe të ruajtura. Rindërtohet ndërsa shfletoni.
cleaner-rules-thunderbird_cache-name = Memoria e fshehtë
cleaner-rules-thunderbird_cache-description = Përmbajtja në distancë dhe të dhënat e burimeve të ruajtura në memorien e fshehtë. Posta, dosjet dhe llogaritë tuaja nuk preken.
cleaner-rules-opera_cache-name = Memoria e fshehtë e Opera
cleaner-rules-opera_cache-description = Memoria e fshehtë e faqeve dhe skripteve të përpiluara të Opera.
cleaner-rules-vivaldi_cache-name = Memoria e fshehtë e Vivaldi
cleaner-rules-vivaldi_cache-description = Memoria e fshehtë e faqeve dhe skripteve të përpiluara të Vivaldi.
cleaner-rules-firefox_deep_cache-name = Memoria e fshehtë e Firefox
cleaner-rules-firefox_deep_cache-description = cache2 dhe memoria e fshehtë e nisjes për çdo profil Firefox. Emrat e dosjeve të profilit janë të rastësishëm, ndaj kjo i përfshin të gjitha.
cleaner-rules-memory_dumps-name = Dump-et e memories
cleaner-rules-memory_dumps-description = Dump-et e rrëzimit që Windows i shkruan pas një rrëzimi të aplikacionit ose të sistemit.
cleaner-rules-windows_error_reporting-name = Windows Error Reporting
cleaner-rules-windows_error_reporting-description = Raporte rrëzimi në radhë dhe të arkivuara që presin të dërgohen te Microsoft.
cleaner-rules-windows_update_leftovers-name = Mbetjet e Windows Update
cleaner-rules-windows_update_leftovers-description = Ngarkesa instaluesish që Windows Update i ka zbatuar tashmë dhe nuk i duhen më. Shpesh disa gigabajtë.
cleaner-rules-delivery_optimization_cache-name = Memoria e fshehtë e Delivery Optimization
cleaner-rules-delivery_optimization_cache-description = Copa përditësimesh që Windows i ruan për t'i ndarë me kompjuterë të tjerë në rrjet.
cleaner-rules-windows_prefetch-name = Prefetch
cleaner-rules-windows_prefetch-description = Të dhëna kohe nisjeje që Windows i përdor për të përshpejtuar nisjen e aplikacioneve. Rindërtohen gjatë disa nisjeve të ardhshme, që janë pak më të ngadalta.
cleaner-rules-windows_font_cache-name = Memoria e fshehtë e shkronjave
cleaner-rules-windows_font_cache-description = Atlase shkronjash të renderuara. Rindërtohen automatikisht në hyrjen tjetër.
cleaner-rules-thumbnail_cache_deep-name = Cache i miniaturave
cleaner-rules-thumbnail_cache_deep-description = Çdo bazë të dhënash miniaturash e ruajtur në cache. Windows i rindërton kur hapni dosje.
cleaner-rules-icon_cache-name = Memoria e fshehtë e ikonave
cleaner-rules-icon_cache-description = Atlase ikonash të File Explorer të ruajtura. Rindërtohen automatikisht; si efekt anësor, rregullon ikonat e vjetruara ose bosh.
cleaner-rules-windows_temp_internet_files-name = Memoria e fshehtë e Internet Explorer / WinINet
cleaner-rules-windows_temp_internet_files-description = Memoria e vjetër e fshehtë WinINet që përdoret ende nga përbërësit e Windows dhe instaluesit e vjetër.
cleaner-rules-internet_explorer_cookies-name = Cookie të Internet Explorer / WinINet
cleaner-rules-internet_explorer_cookies-description = Ju nxjerr nga çdo gjë që përdor ende ruajtjen e vjetër të cookie-ve të IE/WinINet -- disa përbërës më të vjetër të Windows e bëjnë këtë.
cleaner-rules-internet_explorer_history-name = Historia e Internet Explorer / WinINet
cleaner-rules-internet_explorer_history-description = Lista e vjetër e historisë së shfletimit që përdoret ende nga disa përbërës më të vjetër të Windows.
cleaner-rules-internet_explorer_logs-name = Regjistrat e Internet Explorer
cleaner-rules-internet_explorer_logs-description = Një regjistër i vogël markimi që shkruan IE. Vetëm për diagnostikim.
cleaner-rules-windows_cbs_logs-name = Regjistrat e Component Store (CBS)
cleaner-rules-windows_cbs_logs-description = Regjistra shërbimi nga Windows Update dhe DISM. Vetëm për diagnostikim.
cleaner-rules-recent_items_jumplists-name = Elementët e fundit dhe Jump Lists
cleaner-rules-recent_items_jumplists-description = Lista e skedarëve të hapur së fundmi që shfaqin File Explorer dhe Jump Lists e shiritit të detyrave. Heq gjurmët e skedarëve që keni hapur, jo vetë skedarët.
cleaner-rules-windows_explorer_mru-name = Shtigjet e shtypura në Explorer dhe historia e dialogëve
cleaner-rules-windows_explorer_mru-description = Gjurmë në regjistër të dosjeve që keni shtypur në shiritin e adresave të Explorer dhe të skedarëve/dosjeve të zgjedhura në dialogët e zakonshëm Open/Save/Browse. Heq listën e historisë, jo skedarët.
cleaner-rules-windows_explorer_run-name = Historia e dialogut Run të Explorer
cleaner-rules-windows_explorer_run-description = Historia e komandave nga dialogu Run i Win+R.
cleaner-rules-windows_userassist-name = Historiku i nisjes së programeve (UserAssist)
cleaner-rules-windows_userassist-description = Numërimi i Windows për sa shpesh dhe kur keni nisur programe, që rendit listën e më të përdorurave në menunë Start. Windows nis një të ri.
cleaner-rules-windows_regedit_lastkey-name = Redaktori i regjistrit: çelësi i hapur së fundmi
cleaner-rules-windows_regedit_lastkey-description = Çelësi ku hapet sërish Redaktori i regjistrit herën tjetër që e nisni. Vetë regjistri nuk preket.
cleaner-rules-windows_explorer_shellbags-name = Shellbags të Explorer
cleaner-rules-windows_explorer_shellbags-description = Cilësimet e dritares së Explorer për çdo dosje (madhësia, pozicioni, mënyra e pamjes) që Windows i ruan për çdo dosje që keni hapur ndonjëherë, përfshirë ato të fshira. Mund të zbulojë shtigje dosjesh që nuk ekzistojnë më në disk.
cleaner-rules-windows_explorer_recent_documents-name = Dokumentet e fundit në Explorer (regjistër)
cleaner-rules-windows_explorer_recent_documents-description = Lista në regjistër që qëndron pas menysë Recent Documents. Skedarët jump-list në disk që ajo pasqyron mbulohen tashmë nga Elementët e fundit dhe Jump Lists, që mbron dosjet e fiksuara në Quick Access; kjo rregull pastron vetëm vetë listën në regjistër.
cleaner-rules-windows_installer_orphans-name = Instaluesit e shkarkuar (Temp)
cleaner-rules-windows_installer_orphans-description = Ngarkesa konfigurimi që instaluesit i zhpaketojnë në Temp dhe i lënë aty.
cleaner-rules-dns_cache-name = Memoria e fshehtë e DNS
cleaner-rules-dns_cache-description = Pastron memorien e fshehtë të zgjidhësit DNS të Windows. Nuk ka çfarë të vihet në karantinë — ekzekuton drejtpërdrejt ipconfig /flushdns.
cleaner-rules-windows_setup_logs-name = Regjistrat e konfigurimit
cleaner-rules-windows_setup_logs-description = Regjistra të shkruar gjatë instalimeve të Windows dhe përditësimeve të veçorive. Ruhen përgjithmonë, lexohen një herë.
cleaner-rules-windows_servicing_logs-name = Regjistrat e përditësimit dhe shërbimit
cleaner-rules-windows_servicing_logs-description = Regjistrat e Windows Update dhe DISM. Vetëm për diagnostikim; Windows shkruan të rinj sa vjen.
cleaner-rules-windows_system_temp-name = Dosja Temp e sistemit
cleaner-rules-windows_system_temp-description = Dosja Temp e gjithë makinës, në kundërshtim me tuajën. Çdo gjë që përdoret ende anashkalohet.
cleaner-rules-malwarebytes_logs-name = Regjistrat e shërbimit
cleaner-rules-malwarebytes_logs-description = Regjistra skanimi dhe shërbimi. Historia e skanimeve në vetë aplikacionin nuk preket.
cleaner-rules-office_web_cache-name = Memoria e fshehtë e uebit dhe dokumenteve
cleaner-rules-office_web_cache-description = Kopje të ruajtura të dokumenteve në internet dhe të përmbajtjes së uebit. Merren sërish kur hapen përsëri.
cleaner-rules-office_mru-name = Dokumentet e përdorura së fundmi
cleaner-rules-office_mru-description = Shkurtoret që Office shfaq për skedarët e hapur së fundmi. Jo vetë skedarët.
cleaner-rules-qbittorrent_logs-name = Regjistrat
cleaner-rules-qbittorrent_logs-description = Regjistri i ekzekutimit. Torrentet, cilësimet dhe shkarkimet në radhë nuk preken.
cleaner-rules-blitz_cache-name = Memoria e fshehtë
cleaner-rules-blitz_cache-description = Të dhëna champion-ësh, imazhe dhe mbivendosje të ruajtura. Shkarkohen sërish në nisjen tjetër.
cleaner-rules-ubisoft_connect_cache-name = Memoria e fshehtë
cleaner-rules-ubisoft_connect_cache-description = Faqe dyqani, vepra arti dhe lajme të nisësit, të ruajtura.
cleaner-rules-league_of_legends_logs-name = Regjistrat e lojës
cleaner-rules-league_of_legends_logs-description = Regjistra të klientit dhe të lojës për çdo ndeshje. Ruhen pa afat dhe lexohen pothuajse asnjëherë.
cleaner-rules-recycle_bin-name = Koshi i Riciklimit
cleaner-rules-recycle_bin-description = Skedarë që i keni fshirë tashmë, por që ende zënë vend derisa të zbrazet koshi. Zbrazja është pikërisht qëllimi, ndaj asgjë këtu nuk kthehet vetë.
cleaner-rules-user_temp-name = Dosja Temp
cleaner-rules-user_temp-description = Dosja e punës ku shkruajnë Windows, instaluesit dhe gjysma e programeve të makinës dhe që rrallë e pastrojnë pas vetes.
cleaner-rules-system_empty_space-name = Hapësira e lirë e diskut
cleaner-rules-system_empty_space-description = Mbishkruan hapësirën e lirë të një disku që zgjedh (me zero, ose me tre kalime të dhënash të rastësishme), pastaj fshin skedarin mbushës, që skedarët që ke fshirë më parë të mos mund të rikthehen. Mund të zgjasë orë të tëra. Nuk liron hapësirë, nuk bën asgjë të dobishme në një SSD me TRIM dhe shton konsumimin nga shkrimi.
cleaner-rules-defender_history-name = Historia e skanimeve
cleaner-rules-defender_history-description = Rezultatet e ruajtura të skanimeve të mëparshme të Defender dhe regjistri që i liston. Mbrojtja nuk preket; Defender fillon një regjistrim të ri me skanimin e radhës.
cleaner-rules-defender_temp-name = Skedarë të përkohshëm
cleaner-rules-defender_temp-description = Instalues përditësimesh dhe regjistra që Defender i lë në dosjet e përkohshme dhe të përditësimeve të Windows pasi i ka përdorur.
cleaner-rules-defender_quarantine-name = Skedarë në karantinë
cleaner-rules-defender_quarantine-description = Skedarë që Defender i ka kapur dhe i ka mbyllur. Karantina është mënyra si Defender kthen një skedar të shënuar gabimisht — pasi kjo pastrohet, një pozitiv i rremë nuk mund të rikuperohet kurrë.
cleaner-rules-defender_backup-name = Kopja rezervë e përkufizimeve
cleaner-rules-defender_backup-description = Grupi i mëparshëm i përkufizimeve të viruseve, i ruajtur që Defender të mund ta kthejë prapa një përditësim të keq. Një kopje rezervë e re vjen me përditësimin tjetër, por deri atëherë nuk ka ku të kthehet.
cleaner-rules-defender_logs-name = Regjistrat
cleaner-rules-defender_logs-description = Regjistrat e shërbimit dhe të diagnostikimit të vetë Defender. Të dobishëm vetëm kur zgjidhen probleme të vetë Defender; ai shkruan të rinj ndërsa punon.
cleaner-rules-winrar_history-name = Historia
cleaner-rules-winrar_history-description = Emrat e arkivave, dosjet e nxjerrjes dhe termat e kërkimit që mban mend WinRAR. Vetë arkivat nuk preken.
cleaner-rules-winrar_temp-name = Skedarë të përkohshëm
cleaner-rules-winrar_temp-description = Skedarë temp që WinRAR i ka lënë në dosjen e vet të programit. Arkivat dhe cilësimet nuk preken.
cleaner-rules-paint_recent-name = Skedarët e fundit
cleaner-rules-paint_recent-description = Lista e imazheve që Paint ka hapur së fundmi. Vetë imazhet nuk preken.
cleaner-rules-wordpad_recent-name = Skedarët e fundit
cleaner-rules-wordpad_recent-description = Lista e dokumenteve që WordPad ka hapur së fundmi. Vetë dokumentet nuk preken.
cleaner-rules-windows_media_player_history-name = Skedarët dhe dosjet e fundit
cleaner-rules-windows_media_player_history-description = Skedarët dhe adresat e uebit që Windows Media Player ka luajtur së fundmi dhe dosjet që mban mend për Hap dhe Ruaj. Vetë media nuk preket.
cleaner-rules-windows_media_player_cache-name = Memoria e fshehtë
cleaner-rules-windows_media_player_cache-description = Kopertinat e albumeve dhe skedarët e transkoduar në memorien e fshehtë. Krijohen sërish herën tjetër që luani ose sinkronizoni.
cleaner-rules-winzip_history-name = Historia
cleaner-rules-winzip_history-description = Emrat e arkivave dhe punët që WinZip i mban mend. Vetë arkivat nuk preken.
cleaner-rules-tortoisesvn_history-name = Historia
cleaner-rules-tortoisesvn_history-description = Adresat e depove dhe mesazhet e commit që TortoiseSVN i mban mend për dialogët e tij. Kopjet tuaja të punës nuk preken.
cleaner-rules-teamviewer_logs-name = Regjistrat
cleaner-rules-teamviewer_logs-description = Skedarët e vetë TeamViewer për ditarin e diagnostikimit. Cilësimet dhe lidhjet tuaja të ruajtura nuk preken.
cleaner-rules-teamviewer_history-name = Historiku i lidhjeve
cleaner-rules-teamviewer_history-description = Lista e kompjuterëve me të cilët jeni lidhur së fundmi. Kompjuterët mbeten në listën tuaj të kompjuterëve.
cleaner-rules-filezilla_recent_servers-name = Serverët e fundit
cleaner-rules-filezilla_recent_servers-description = Serverët që FileZilla i shfaq te “Serverët e fundit” në listën rënëse të lidhjes. Hyrjet e Menaxherit të faqeve nuk preken.
cleaner-rules-deepscan_backup-name = Skedarë rezervë
cleaner-rules-deepscan_backup-description = Skedarë që mbarojnë me .bak, ose me deri në katër shkronja dhe një tildë (si notes.txt~), kudo në dosjen tënde të përdoruesit. Redaktuesit shpesh lënë si kopje rezervë të vetmen kopje të diçkaje, ndaj kontrollo pamjen paraprake për gjithçka që do të ruash.
cleaner-rules-deepscan_tmp-name = Skedarë të përkohshëm të Office
cleaner-rules-deepscan_tmp-description = Skedarë pune të Word (~wr dhe katër shifra) dhe PowerPoint (ppt dhe katër shifra), kudo në dosjen tënde të përdoruesit. Pas një prishjeje, njëri prej tyre mund të mbajë të vetmen kopje të punës së paruajtur.
cleaner-rules-deepscan_vim_swap-name = Skedarë swap të Vim
cleaner-rules-deepscan_vim_swap-description = Skedarët .swp, .swo dhe .swn të Vim, kudo në dosjen tënde të përdoruesit. Vim i shkruan ndërsa redakton dhe pas një prishjeje ata mbajnë ndryshimet e paruajtura.
cleaner-rules-deepscan_ds_store-name = Skedarë .DS_Store
cleaner-rules-deepscan_ds_store-description = Skedarë të pamjes së dosjes që macOS i lë në dosjet e kopjuara nga një Mac. Në Windows asgjë nuk i lexon.
cleaner-rules-deepscan_thumbs_db-name = Skedarë Thumbs.db
cleaner-rules-deepscan_thumbs_db-description = Memorie e fshehtë miniaturash që versionet e vjetra të Windows i lanë në dosjet e fotove. Explorer ndërton të reja nëse i duhen.
