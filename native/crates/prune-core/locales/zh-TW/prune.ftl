uninstallerV3-history-field-freed = 釋放的空間
uninstallerV3-history-field-destination = 去向
uninstallerV3-history-field-tasks = 已移除的排程工作
uninstallerV3-history-field-restorePoint = 還原點
uninstallerV3-history-field-registryBackup = 登錄備份
uninstallerV3-history-field-quarantineBatch = 隔離批次
uninstallerV3-history-restoreCreated = 已建立
