propertiesV1-opening = Đang mở…
propertiesV1-failed = Không thể mở Thuộc tính: { $reason }
sizeUnitsV1-setting-title = Đơn vị kích thước
sizeUnitsV1-setting-description = Cách Prune ghi kích thước trên mọi màn hình, ở khay hệ thống và trong thông báo. File Explorer tính 1024 byte cho mỗi kilobyte; nhà sản xuất ổ đĩa tính 1000, vì vậy ổ 1 TB hiển thị là 931 GB trong Windows.
sizeUnitsV1-options-windows = Giống File Explorer (KB, MB · 1024)
sizeUnitsV1-options-binary = Nhị phân (KiB, MiB · 1024)
sizeUnitsV1-options-decimal = Thập phân (KB, MB · 1000)
sizeUnitsV1-gibUnit = GiB
windowsToolsV1-button = Công cụ Windows
windowsToolsV1-title = Công cụ Windows
windowsToolsV1-intro = Các công cụ của chính Windows, chỉ một cú nhấp. Mỗi công cụ mở giống hệt như từ menu Bắt đầu; Prune chỉ khởi động nó.
windowsToolsV1-loading = Đang tìm các công cụ trên PC này…
windowsToolsV1-loadError = Không thể liệt kê các công cụ: { $reason }
windowsToolsV1-groups-repair = Sửa chữa
windowsToolsV1-groups-diagnose = Chẩn đoán
windowsToolsV1-groups-manage = Quản lý
windowsToolsV1-groups-programs = Chương trình
windowsToolsV1-groups-network = Mạng
windowsToolsV1-groups-access = Bảo mật và trợ năng
windowsToolsV1-admin = Yêu cầu quyền quản trị
windowsToolsV1-console = Chạy trong Command Prompt luôn mở
windowsToolsV1-open = Mở
windowsToolsV1-run = Chạy
windowsToolsV1-opening = Đang mở…
windowsToolsV1-cancelled = Windows không được cấp quyền, nên không có gì được khởi động.
windowsToolsV1-failed = Không thể khởi động: { $reason }
windowsToolsV1-flushed = Đã xóa bộ nhớ đệm DNS.
windowsToolsV1-close = Đóng
windowsToolsV1-tools-systemRestore-name = Khôi phục Hệ thống
windowsToolsV1-tools-systemRestore-description = Đưa Windows về một điểm khôi phục trước đó.
windowsToolsV1-tools-sfc-name = Trình kiểm tra Tệp Hệ thống
windowsToolsV1-tools-sfc-description = Tìm và sửa các tệp Windows bị hỏng.
windowsToolsV1-tools-dism-name = Sửa ảnh Windows
windowsToolsV1-tools-dism-description = Sửa ảnh Windows mà Trình kiểm tra Tệp Hệ thống dùng để khôi phục.
windowsToolsV1-tools-chkdsk-name = Kiểm tra đĩa
windowsToolsV1-tools-chkdsk-description = Tìm lỗi hệ thống tệp trên ổ Windows mà không thay đổi gì.
windowsToolsV1-tools-diskCleanup-name = Dọn dẹp Ổ đĩa
windowsToolsV1-tools-diskCleanup-description = Trình dọn dẹp tệp tạm và tệp hệ thống của chính Windows.
windowsToolsV1-tools-systemInformation-name = Thông tin Hệ thống
windowsToolsV1-tools-systemInformation-description = Phần cứng, trình điều khiển và chi tiết Windows trong một báo cáo.
windowsToolsV1-tools-eventViewer-name = Trình xem Sự kiện
windowsToolsV1-tools-eventViewer-description = Nhật ký lỗi, cảnh báo và sự kiện của Windows.
windowsToolsV1-tools-resourceMonitor-name = Trình theo dõi Tài nguyên
windowsToolsV1-tools-resourceMonitor-description = Mức dùng bộ xử lý, bộ nhớ, đĩa và mạng theo thời gian thực của từng chương trình.
windowsToolsV1-tools-directxDiagnostics-name = Chẩn đoán DirectX
windowsToolsV1-tools-directxDiagnostics-description = Chi tiết đồ họa và âm thanh, kèm báo cáo có thể lưu.
windowsToolsV1-tools-systemProperties-name = Thuộc tính Hệ thống
windowsToolsV1-tools-systemProperties-description = Hiệu suất, bộ nhớ ảo, biến môi trường và khôi phục.
windowsToolsV1-tools-services-name = Dịch vụ
windowsToolsV1-tools-services-description = Khởi động, dừng và chọn cách khởi động các dịch vụ Windows.
windowsToolsV1-tools-taskScheduler-name = Bộ lập lịch Tác vụ
windowsToolsV1-tools-taskScheduler-description = Mọi thứ được đặt để chạy theo lịch hoặc khi có sự kiện.
windowsToolsV1-tools-deviceManager-name = Trình quản lý Thiết bị
windowsToolsV1-tools-deviceManager-description = Phần cứng và trình điều khiển: cập nhật, khôi phục hoặc tắt.
windowsToolsV1-tools-diskManagement-name = Quản lý Đĩa
