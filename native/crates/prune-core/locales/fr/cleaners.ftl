cleaner-rules-steam_shader_cache-name = Cache de shaders
cleaner-rules-steam_shader_cache-description = Shaders compilés des jeux installés. Reconstruit au prochain lancement de chaque jeu.
cleaner-rules-steam_depot_cache-name = Restes de téléchargement
